# Python 3.12 / local development
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Structured product intent and answer consistency; requires JSON-schema-capable routing.
PRODUCT_INTENT_MODEL=openai/gpt-4.1
EVAL_MODEL=google/gemini-2.5-flash
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_DIMENSIONS=2048
SEMANTIC_TOP_K=5
PINECONE_API_KEY=
PINECONE_INDEX_NAME=chatbot-nadhif
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=chatbot-avg
# LANGSMITH_WORKSPACE_ID=
FONNTE_TOKEN=
# WAHA migration: backend can reach a remote WAHA server over HTTPS.
WHATSAPP_PROVIDER=waha
WAHA_BASE_URL=https://your-waha-server.example.com
WAHA_API_KEY=
WAHA_SESSION=asia-chatbot
WAHA_WEBHOOK_SECRET=
WAHA_WEBHOOK_URL=https://your-backend.example.com/chat/waha/webhook
WAHA_TYPING_ENABLED=true
DATA_DIR=./data
# PostgreSQL runtime uses the restricted chatbot_app role; migration uses admin.
DATABASE_URL=
DATABASE_MIGRATION_URL=
SUPABASE_URL=
# Server only. A modern sb_secret key or legacy service_role key; never VITE_ prefixed.
SUPABASE_SECRET_KEY=
# Existing administrator account is imported; startup does not provision users.
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
